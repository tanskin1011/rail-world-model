# Copy to cluster.env on both nodes and set rank 0's ConnectX-7 address.
# cluster.env is ignored because it is machine-specific.

NNODES=2
NPROC_PER_NODE=1
MASTER_ADDR=192.168.100.10
MASTER_PORT=50012

# Set separately on each node:
#   export NODE_RANK=0  # first Spark
#   export NODE_RANK=1  # second Spark

DATASET_PATH=examples/data/BridgeData2-Subset-Synthetic-Captions/sft_dataset_bridge
BASE_CHECKPOINT_PATH=examples/checkpoints/Cosmos3-Nano
WAN_VAE_PATH=examples/checkpoints/wan22_vae/Wan2.2_VAE.pth
